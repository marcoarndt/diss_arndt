\contentsline {figure}{\numberline {4.1}{\ignorespaces Funktionsstruktur mit Haupt-, Neben- und Teilfunktionen zur lückenlosen Identifikation funktionskritischer Einflussgrößen (in Anlehnung an \blx@tocontentsinit {0}\cite {Arndt.2023c} nach \blx@tocontentsinit {0}\cite {Wallace.2007}).}}{64}{figure.caption.57}%
